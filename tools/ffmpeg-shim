#!/bin/sh
# ffmpeg shim for Moonraker-Timelapse on K2
# - Input: Moonraker's MJPEG command (from installer --encoder mjpeg)
# - Output: hardware-accelerated H.264 via h264_v4l2m2m

echo "shim called: $@" >> /tmp/ffmpeg-shim.log

# BusyBox sh only supports -e
set -e
# ORIGINAL:
# set -euo pipefail

REAL_FFMPEG="/usr/bin/ffmpeg.real"
# ORIGINAL:
# REAL_FFMPEG=/usr/bin/ffmpeg.real

OUT=""
SKIP_NEXT=0

for arg in "$@"; do
    if [ "$SKIP_NEXT" = 1 ]; then
        SKIP_NEXT=0
        continue
    fi

    case "$arg" in
        ############################################################
        # CODEC REWRITES
        ############################################################

        # Moonraker (MJPEG mode): -vcodec mjpeg
        -vcodec)
            # Force hardware H.264 encoder
            OUT="$OUT -vcodec h264_v4l2m2m"
            # ORIGINAL:
            # OUT="$OUT -vcodec"
            SKIP_NEXT=1
            ;;

        mjpeg)
            # Skip original mjpeg value (we already forced h264_v4l2m2m)
            # ORIGINAL:
            # OUT="$OUT mjpeg"
            ;;

        # If installer ever uses libx264, upgrade to hardware too
        libx264)
            OUT="$OUT h264_v4l2m2m"
            # ORIGINAL:
            # OUT="$OUT libx264"
            ;;

        ############################################################
        # REMOVE FLAGS THAT BREAK HARDWARE ENCODER
        ############################################################

        -q:v)
            # Hardware encoders don't support qscale; replace with bitrate model
            OUT="$OUT -b:v 4M -maxrate 4M -bufsize 8M"
            # ORIGINAL:
            # OUT="$OUT -q:v"
            SKIP_NEXT=1
            ;;

        -threads)
            # Hardware encoders ignore or dislike thread control; drop it
            # ORIGINAL:
            # OUT="$OUT -threads"
            SKIP_NEXT=1
            ;;

        ############################################################
        # PIXEL FORMAT ADJUSTMENT
        ############################################################

        -pix_fmt)
            # Force a hardware-friendly pixel format
            OUT="$OUT -pix_fmt nv12"
            # ORIGINAL:
            # OUT="$OUT -pix_fmt"
            SKIP_NEXT=1
            ;;

        yuv420p)
            # Skip original pix_fmt value
            # ORIGINAL:
            # OUT="$OUT yuv420p"
            ;;

        ############################################################
        # DEFAULT: PASS THROUGH
        ############################################################

        *)
            OUT="$OUT $arg"
            ;;
    esac
done

exec "$REAL_FFMPEG" $OUT
# ORIGINAL:
# exec $REAL_FFMPEG "$@"
